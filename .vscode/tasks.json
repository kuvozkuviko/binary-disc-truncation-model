{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "gfortran build",
            "type": "shell",
            "command": "gfortran",
            "args": [
                "-o",
                "${fileDirname}/output_program",
                "${file}"
            ],
            "group": {
                "kind": "build",
                "isDefualt": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Compile Fortran code using gfortran"
        }
    ]
}
